---
import '../../styles/global.css';
import mysql from 'mysql2/promise';

const namaSekolah = "MI Hidayatul Husna Krasak";

const url = new URL(Astro.request.url);
const pendaftarId = url.searchParams.get('id');

let siswa: any = null;
let listPertanyaan: any[] = [];
let jawabanSiswa: Record<number, string> = {};
let errorMessage = '';

if (pendaftarId) {
  try {
    const connection: any = await mysql.createConnection({
      host: 'localhost', user: 'root', password: '', database: 'pmbm_madrasah',
    });

    // 1. Ambil data siswa
    const [sRows] = await connection.query('SELECT id, no_pendaftaran, nama_siswa FROM pendaftar WHERE id = ?', [pendaftarId]);
    const sList = sRows as any[];
    if (sList.length > 0) siswa = sList[0];

    // 2. Ambil daftar pertanyaan kuesioner
    const [qRows] = await connection.query('SELECT * FROM kuesioner_pertanyaan ORDER BY id ASC');
    listPertanyaan = qRows as any[];

    // 3. Ambil jawaban yang sudah pernah disimpan
    const [jRows] = await connection.query('SELECT pertanyaan_id, jawaban FROM kuesioner_jawaban WHERE pendaftar_id = ?', [pendaftarId]);
    (jRows as any[]).forEach(j => {
      jawabanSiswa[j.pertanyaan_id] = j.jawaban;
    });

    await connection.end();
  } catch (err: any) {
    console.error("Error di isi-kuisoner.astro:", err.message);
    errorMessage = err.message;
  }
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Form Kuesioner Siswa - {siswa ? siswa.nama_siswa : 'Admin'}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
  </head>
  <body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col justify-between pb-16">

    <!-- HEADER NAVBAR (RESPONSIF) -->
    <header class="bg-emerald-900 text-white sticky top-0 z-40 shadow-md border-b border-emerald-800">
      <div class="max-w-3xl mx-auto px-4 py-3 flex flex-col sm:flex-row items-center justify-between gap-2">
        <a href="/admin/kuisoner" class="w-full sm:w-auto text-center bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-xs px-3.5 py-2 rounded-xl transition">
          ← Kembali ke Rekap Kuesioner
        </a>
        <div id="saveIndicator" class="w-full sm:w-auto text-center text-[11px] font-bold text-emerald-200 bg-emerald-950/80 px-3 py-1.5 rounded-xl border border-emerald-700">
          ☁️ Perubahan Tersimpan Otomatis
        </div>
      </div>
    </header>

    <!-- CONTENT FORMULIR PENUH -->
    <main class="max-w-3xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full space-y-6 flex-1">
      {errorMessage ? (
        <div class="bg-rose-100 p-6 rounded-3xl text-center space-y-2 border border-rose-300">
          <p class="font-bold text-rose-800 text-sm">❌ Terjadi Kesalahan Database / Server:</p>
          <p class="text-xs font-mono bg-white p-3 rounded border text-rose-600">{errorMessage}</p>
          <a href="/admin/kuisoner" class="inline-block bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl mt-2">Kembali</a>
        </div>
      ) : !siswa ? (
        <div class="bg-white p-8 rounded-3xl text-center space-y-4 shadow border">
          <p class="font-bold text-rose-700 text-sm">❌ Data Pendaftar Tidak Ditemukan.</p>
          <a href="/admin/kuisoner" class="inline-block bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl">Kembali</a>
        </div>
      ) : (
        <div class="bg-white p-4 sm:p-10 rounded-3xl border border-slate-200 shadow-xl space-y-6">
          
          <!-- JUDUL INFORMASI SISWA -->
          <div class="border-b border-slate-100 pb-4 space-y-2">
            <span class="inline-block text-xs font-black text-emerald-800 bg-emerald-100/80 px-3 py-1 rounded-full border border-emerald-200 uppercase tracking-wide">
              NO. REG: {siswa.no_pendaftaran}
            </span>
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight">
              Kuesioner Karakteristik: {siswa.nama_siswa}
            </h1>
            <p class="text-xs text-slate-500">
              Setiap ketikan atau perubahan pilihan jawaban akan langsung <strong class="text-emerald-700">disimpan otomatis</strong> ke server.
            </p>
          </div>

          <!-- FORM AUTOSAVE -->
          <form id="formAutosaveKuis" class="space-y-4 sm:space-y-6">
            <input type="hidden" id="pendaftarId" value={siswa.id}>

            {listPertanyaan.length === 0 ? (
              <div class="text-center py-10 bg-slate-50 rounded-2xl border border-dashed border-slate-300 p-6 space-y-3">
                <p class="text-slate-500 text-xs font-bold">Belum ada pertanyaan kuesioner yang dibuat oleh admin.</p>
                <a href="/admin/pertanyaan" class="inline-block bg-amber-600 text-white font-bold text-xs px-4 py-2 rounded-xl shadow">
                  ⚙️ Buat Pertanyaan Sekarang
                </a>
              </div>
            ) : (
              listPertanyaan.map((q, idx) => {
                const val = jawabanSiswa[q.id] || '';
                return (
                  <div class="space-y-2 bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm transition">
                    <label class="block font-extrabold text-slate-900 text-xs sm:text-sm leading-relaxed">
                      {idx + 1}. {q.pertanyaan} <span class="text-rose-500">*</span>
                    </label>

                    {q.tipe_input === 'select' ? (
                      <select 
                        name={`q_${q.id}`} 
                        data-qid={q.id} 
                        class="autosave-input w-full p-3.5 bg-white rounded-xl border border-slate-300 text-xs sm:text-sm font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none shadow-sm"
                      >
                        <option value="">-- Pilih Jawaban --</option>
                        {(q.pilihan_opsi || '').split(',').map((o: string) => (
                          <option value={o.trim()} selected={val === o.trim()}>{o.trim()}</option>
                        ))}
                      </select>
                    ) : (
                      <input 
                        type="text" 
                        name={`q_${q.id}`} 
                        data-qid={q.id} 
                        value={val} 
                        placeholder="Tuliskan jawaban karakteristik..." 
                        class="autosave-input w-full p-3.5 bg-white rounded-xl border border-slate-300 text-xs sm:text-sm font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none shadow-sm"
                      />
                    )}
                  </div>
                );
              })
            )}

            <!-- TOMBOL NAVIGASI BAWAH -->
            <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-3">
              <a 
                href="/admin/kuisoner" 
                class="w-full sm:w-auto text-center bg-slate-800 hover:bg-slate-900 active:scale-95 text-white font-bold text-xs px-6 py-3.5 rounded-xl shadow transition"
              >
                ← Selesai & Kembali ke Rekap
              </a>
              <span id="statusTeks" class="text-xs font-bold text-emerald-700">
                Semua perubahan tersimpan
              </span>
            </div>
          </form>

        </div>
      )}
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t py-4 text-center text-xs text-slate-500">
      © 2026 {namaSekolah}. Autosave Kuesioner Karakteristik.
    </footer>

    <!-- SCRIPT AUTOSAVE -->
    <script>
      if (!sessionStorage.getItem('isAdminLoggedIn')) window.location.href = '/admin/login';

      const pendaftarId = (document.getElementById('pendaftarId') as HTMLInputElement)?.value;
      const saveIndicator = document.getElementById('saveIndicator');
      const statusTeks = document.getElementById('statusTeks');
      let timeoutId: any = null;

      async function simpanOtomatis() {
        if (!pendaftarId) return;
        if (saveIndicator) saveIndicator.innerText = '⏳ Menyimpan...';
        if (statusTeks) statusTeks.innerText = 'Menyimpan...';

        const jawabanObj: any = {};
        document.querySelectorAll('.autosave-input').forEach((el: any) => {
          const qId = el.getAttribute('data-qid');
          jawabanObj[qId] = el.value;
        });

        try {
          const res = await fetch('/api/kuesioner-jawaban', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'simpan_jawaban',
              pendaftar_id: pendaftarId,
              jawaban: jawabanObj
            })
          });
          const result = await res.json();
          if (result.success) {
            if (saveIndicator) saveIndicator.innerText = '☁️ Tersimpan Otomatis';
            if (statusTeks) statusTeks.innerText = 'Tersimpan otomatis di database';
          }
        } catch (err) {
          if (saveIndicator) saveIndicator.innerText = '⚠️ Gagal Menyimpan';
        }
      }

      document.querySelectorAll('.autosave-input').forEach(el => {
        el.addEventListener('input', () => {
          if (saveIndicator) saveIndicator.innerText = '✍️ Mengetik...';
          if (statusTeks) statusTeks.innerText = 'Mengetik...';
          
          clearTimeout(timeoutId);
          timeoutId = setTimeout(simpanOtomatis, 600);
        });

        el.addEventListener('change', () => {
          simpanOtomatis();
        });
      });
    </script>
  </body>
</html>