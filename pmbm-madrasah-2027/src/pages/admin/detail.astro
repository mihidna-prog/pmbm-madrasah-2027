---
import '../../styles/global.css';
import mysql from 'mysql2/promise';

const namaSekolah = "MI Hidayatul Husna Krasak";
const alamatSekolah = "Krasak, Pecangaan, Jepara";
const tahunAjaran = "2027/2028";

// ✅ Ambil & validasi id
const url = new URL(Astro.request.url);
const idParam = url.searchParams.get('id');
const id = idParam && /^\d+$/.test(idParam) ? Number(idParam) : null;

// ✅ Interface lengkap
interface Pendaftar {
  id: number;
  no_pendaftaran: string;
  status_pendaftaran: string;
  biaya_pendaftaran?: number;
  biaya_seragam?: number;

  nama_siswa: string;
  nik_siswa?: string;
  nisn?: string;
  jenis_kelamin?: string;
  asal_sekolah?: string;
  tempat_lahir?: string;
  tanggal_lahir?: string;
  anak_ke?: number;
  jumlah_saudara?: number;
  no_kk?: string;
  tinggi_badan?: number;
  berat_badan?: number;

  alamat_rt?: string;
  alamat_rw?: string;
  alamat_desa?: string;
  alamat_kecamatan?: string;

  nama_ayah?: string;
  nik_ayah?: string;
  hp_ayah?: string;
  pekerjaan_ayah?: string;
  penghasilan_ayah?: string;
  nama_ibu?: string;
  nik_ibu?: string;
  hp_ibu?: string;
  pekerjaan_ibu?: string;
  penghasilan_ibu?: string;

  bantuan_sosial?: string;
  ukuran_atasan?: string;
  ukuran_bawahan?: string;

  foto_siswa?: string;
  foto_akta?: string;
  foto_kk?: string;
  foto_rumah?: string;
  foto_pkh?: string;
  foto_pip?: string;
  foto_kip?: string;
  foto_bpnt?: string;

  created_at?: string;
  [key: string]: unknown;
}

let data: Pendaftar | null = null;
let dbError = false;

if (id) {
  // ✅ Pakai `any` untuk bypass masalah tipe mysql2
  let connection: any = null;

  try {
    connection = await mysql.createConnection({
      host: import.meta.env.DB_HOST ?? 'localhost',
      user: import.meta.env.DB_USER ?? 'root',
      password: import.meta.env.DB_PASSWORD ?? '',
      database: import.meta.env.DB_NAME ?? 'pmbm_madrasah',
    });

    const [rows]: any = await connection.execute(
      'SELECT * FROM pendaftar WHERE id = ?',
      [id]
    );

    if (rows && rows.length > 0) {
      data = rows[0] as Pendaftar;
    }
  } catch (err) {
    console.error('DB Error:', err);
    dbError = true;
  } finally {
    if (connection) await connection.end();
  }
}

const tanggalCetak = new Date().toLocaleDateString('id-ID', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const fmtTanggal = (t?: string) =>
  t ? new Date(t).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Edit & Detail Pendaftar - {data ? data.nama_siswa : 'Admin'}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      #modalCetakResi.hidden { display: none; }

      /* ============================================================
         CSS CETAK — 2 LEMBAR A4, TINGGI DIKUNCI, ANTI HALAMAN HANTU
         ============================================================ */
      @media print {
        html, body {
          margin: 0 !important;
          padding: 0 !important;
          background: #fff !important;
          width: 210mm !important;
          height: auto !important;
        }
        body * { visibility: hidden; }

        #modalCetakResi,
        #modalCetakResi * { visibility: visible; }

        #modalCetakResi {
          position: absolute !important;
          left: 0 !important;
          top: 0 !important;
          width: 210mm !important;
          height: auto !important;
          min-height: auto !important;
          max-height: none !important;
          background: #fff !important;
          padding: 0 !important;
          margin: 0 !important;
          display: block !important;
          z-index: 99999 !important;
          overflow: visible !important;
          backdrop-filter: none !important;
          box-shadow: none !important;
          border: none !important;
        }

        .print-container {
          display: block !important;
          width: 210mm !important;
          max-width: 210mm !important;
          margin: 0 !important;
          padding: 0 !important;
          gap: 0 !important;
          background: #fff !important;
        }

        /* KERTAS — tinggi fix 287mm, overflow dipotong */
        .page-sheet {
          width: 210mm !important;
          height: 287mm !important;
          max-height: 287mm !important;
          min-height: 287mm !important;
          padding: 8mm 12mm !important;
          margin: 0 !important;
          background: #fff !important;
          border: none !important;
          border-radius: 0 !important;
          box-shadow: none !important;
          box-sizing: border-box !important;
          overflow: hidden !important;
          page-break-after: always !important;
          break-after: page !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          font-size: 10pt !important;
          line-height: 1.3 !important;
          color: #000 !important;
          position: relative !important;
          display: block !important;
        }

        /* Lembar terakhir: matikan page-break-after */
        .page-sheet:last-of-type {
          page-break-after: auto !important;
          break-after: auto !important;
        }

        .no-print,
        .toolbar,
        #btnOpenCetak,
        #btnCetakBawah,
        header, nav, footer {
          display: none !important;
          visibility: hidden !important;
        }

        * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        @page {
          size: A4 portrait;
          margin: 0;
        }

        .print-container > *:first-child { margin-top: 0 !important; }
        .print-container > *:last-child { margin-bottom: 0 !important; }
        .page-sheet > *:first-child { margin-top: 0 !important; }
        .page-sheet > *:last-child { margin-bottom: 0 !important; }

        .form-table { width: 100% !important; border-collapse: collapse !important; }
        .form-table td { padding: 1.5px 4px !important; font-size: 10pt !important; vertical-align: top; }
        .form-table td.label { width: 32% !important; }
        .form-table td.sep { width: 8px !important; }

        .kop-surat {
          border-bottom: 2px solid #000 !important;
          padding-bottom: 4px !important;
          margin-bottom: 6px !important;
        }

        .judul-form { text-align: center; margin: 6px 0 8px !important; }
        .judul-form h2 { font-size: 11pt !important; margin: 0 !important; text-decoration: underline; letter-spacing: 1px; }
        .judul-form p { font-size: 9pt !important; margin: 2px 0 0 !important; }

        .section-title {
          font-size: 10pt !important;
          font-weight: 800 !important;
          background: #e5e7eb !important;
          padding: 2px 6px !important;
          margin: 6px 0 3px !important;
          border: 1px solid #000 !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .ttd {
          display: flex !important;
          justify-content: space-between !important;
          margin-top: 12px !important;
          padding: 0 10px !important;
        }
        .ttd > div { width: 45% !important; text-align: center !important; font-size: 10pt !important; }
        .ttd .ruang-ttd { height: 45px !important; }

        .catatan-print {
          margin-top: 8px !important;
          padding: 4px 8px !important;
          border: 1px dashed #333 !important;
          font-size: 8.5pt !important;
          line-height: 1.3 !important;
        }

        .status-berkas-print {
          margin-top: 6px !important;
          border: 1px solid #000 !important;
          padding: 3px !important;
        }
        .status-berkas-print table {
          width: 100% !important;
          border-collapse: collapse !important;
          text-align: center;
        }
        .status-berkas-print table td {
          border: 1px solid #666 !important;
          padding: 2px !important;
          font-size: 8.5pt !important;
        }

        .foto-box {
          width: 25mm !important;
          height: 32mm !important;
        }
      }
    </style>
  </head>
  <body class="bg-slate-100 text-slate-800 antialiased min-h-screen pb-16">

    <!-- Header Navigation -->
    <header class="bg-emerald-900 text-white sticky top-0 z-30 shadow-md no-print">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/admin" class="bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-xs px-3.5 py-2 rounded-xl border border-emerald-700 transition">
          ← Dashboard Admin
        </a>
        <span class="font-extrabold text-xs sm:text-sm tracking-tight">{namaSekolah}</span>
      </div>
    </header>

    <!-- Content Utama -->
    <main class="max-w-4xl mx-auto px-3 sm:px-4 py-6">
      {dbError ? (
        <div class="bg-white p-8 rounded-3xl text-center shadow border">
          <p class="font-bold text-rose-700 text-sm">⚠️ Gagal mengakses database.</p>
        </div>
      ) : !id ? (
        <div class="bg-white p-8 rounded-3xl text-center space-y-4 shadow border">
          <p class="font-bold text-rose-700 text-sm">⚠️ Parameter ID tidak valid.</p>
          <a href="/admin" class="inline-block bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl">Kembali</a>
        </div>
      ) : !data ? (
        <div class="bg-white p-8 rounded-3xl text-center space-y-4 shadow border">
          <p class="font-bold text-rose-700 text-sm">❌ Data Pendaftar Tidak Ditemukan.</p>
          <a href="/admin" class="inline-block bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl">Kembali</a>
        </div>
      ) : (
        <div class="bg-white p-4 sm:p-10 rounded-3xl border border-slate-200 shadow-xl space-y-8">

          <!-- Header Judul -->
          <div class="border-b border-slate-100 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 uppercase tracking-wider">
                NO. REG: {data.no_pendaftaran}
              </span>
              <h1 class="text-xl sm:text-2xl font-black text-slate-900 mt-2">Koreksi Data & Berkas Pendaftar</h1>
              <p class="text-xs text-slate-500">Pendaftaran Tanggal: {new Date(data.created_at ?? '').toLocaleDateString('id-ID')}</p>
            </div>
            <button type="button" id="btnOpenCetak" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow transition no-print">
              🖨️ Cetak Formulir Penuh (2 Lembar A4)
            </button>
          </div>

          <!-- FORM EDIT LENGKAP -->
          <form id="formAdminDetail" class="space-y-8">
            <input type="hidden" name="id" value={data.id}>

            <!-- PANEL KONTROL KEUANGAN & VALIDASI -->
            <div class="bg-emerald-50 border-2 border-emerald-200 p-4 sm:p-5 rounded-2xl space-y-4">
              <div class="border-b border-emerald-200 pb-2 flex items-center justify-between">
                <h2 class="font-extrabold text-emerald-950 text-xs sm:text-sm flex items-center gap-2">
                  <span>⚙️</span> PANEL KONTROL VALIDASI & KEUANGAN (ADMIN)
                </h2>
                <span class="text-[10px] bg-emerald-200 text-emerald-900 font-bold px-2.5 py-0.5 rounded-full">Panitia</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Status Validasi Fisik</label>
                  <select name="status_pendaftaran" class="w-full p-3 bg-white rounded-xl border border-slate-300 font-bold text-slate-800">
                    <option value="Pending" selected={data.status_pendaftaran === 'Pending'}>Pending</option>
                    <option value="Sudah Validasi" selected={data.status_pendaftaran === 'Sudah Validasi'}>Sudah Validasi</option>
                    <option value="Batal" selected={data.status_pendaftaran === 'Batal'}>Batal Mendaftar</option>
                  </select>
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Biaya Pendaftaran (Rp)</label>
                  <input type="number" name="biaya_pendaftaran" value={data.biaya_pendaftaran || 0} class="w-full p-3 bg-white rounded-xl border border-slate-300 font-bold text-emerald-800">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Titipan Uang Seragam (Rp)</label>
                  <input type="number" name="biaya_seragam" value={data.biaya_seragam || 0} class="w-full p-3 bg-white rounded-xl border border-slate-300 font-bold text-teal-800">
                </div>
              </div>
            </div>

            <!-- BAGIAN 0: FOTO & BERKAS -->
            <div class="space-y-4">
              <h2 class="text-sm font-extrabold text-slate-900 bg-slate-100 p-3 rounded-xl border flex items-center gap-2">
                <span>📸</span> 0. Berkas Foto & Dokumen Utama
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                <div class="bg-slate-50 p-4 rounded-2xl border text-center space-y-2">
                  <p class="font-bold text-slate-700">1. Pasfoto Siswa</p>
                  <div class="w-full h-32 mx-auto bg-white border rounded-xl overflow-hidden flex items-center justify-center shadow-sm relative">
                    <img id="img_preview_pasfoto" src={data.foto_siswa || ''} alt="Pasfoto" class={`w-full h-full object-cover ${!data.foto_siswa ? 'hidden' : ''}`} />
                    <span id="text_placeholder_pasfoto" class={`absolute text-[10px] text-slate-400 font-bold ${data.foto_siswa ? 'hidden' : ''}`}>Tidak Ada Foto</span>
                  </div>
                  <input type="file" id="file_pasfoto" accept="image/*" class="w-full text-[10px] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                  <input type="hidden" name="foto_siswa" id="hidden_pasfoto" value={data.foto_siswa || ''}>
                </div>

                <div class="bg-slate-50 p-4 rounded-2xl border text-center space-y-2">
                  <p class="font-bold text-slate-700">2. Akta Kelahiran</p>
                  <div class="w-full h-32 mx-auto bg-white border rounded-xl overflow-hidden flex items-center justify-center shadow-sm relative">
                    <img id="img_preview_akta" src={data.foto_akta || ''} alt="Akta" class={`w-full h-full object-cover ${!data.foto_akta ? 'hidden' : ''}`} />
                    <span id="text_placeholder_akta" class={`absolute text-[10px] text-slate-400 font-bold ${data.foto_akta ? 'hidden' : ''}`}>Tidak Ada Akta</span>
                  </div>
                  <input type="file" id="file_akta" accept="image/*" class="w-full text-[10px] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                  <input type="hidden" name="foto_akta" id="hidden_akta" value={data.foto_akta || ''}>
                </div>

                <div class="bg-slate-50 p-4 rounded-2xl border text-center space-y-2">
                  <p class="font-bold text-slate-700">3. Kartu Keluarga</p>
                  <div class="w-full h-32 mx-auto bg-white border rounded-xl overflow-hidden flex items-center justify-center shadow-sm relative">
                    <img id="img_preview_kk" src={data.foto_kk || ''} alt="KK" class={`w-full h-full object-cover ${!data.foto_kk ? 'hidden' : ''}`} />
                    <span id="text_placeholder_kk" class={`absolute text-[10px] text-slate-400 font-bold ${data.foto_kk ? 'hidden' : ''}`}>Tidak Ada KK</span>
                  </div>
                  <input type="file" id="file_kk" accept="image/*" class="w-full text-[10px] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                  <input type="hidden" name="foto_kk" id="hidden_kk" value={data.foto_kk || ''}>
                </div>

                <div class="bg-slate-50 p-4 rounded-2xl border text-center space-y-2">
                  <p class="font-bold text-slate-700">4. Foto Depan Rumah</p>
                  <div class="w-full h-32 mx-auto bg-white border rounded-xl overflow-hidden flex items-center justify-center shadow-sm relative">
                    <img id="img_preview_rumah" src={data.foto_rumah || ''} alt="Rumah" class={`w-full h-full object-cover ${!data.foto_rumah ? 'hidden' : ''}`} />
                    <span id="text_placeholder_rumah" class={`absolute text-[10px] text-slate-400 font-bold ${data.foto_rumah ? 'hidden' : ''}`}>Tidak Ada Rumah</span>
                  </div>
                  <input type="file" id="file_rumah" accept="image/*" class="w-full text-[10px] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                  <input type="hidden" name="foto_rumah" id="hidden_rumah" value={data.foto_rumah || ''}>
                </div>
              </div>
            </div>

            <!-- BAGIAN 1: DATA SISWA -->
            <div class="space-y-4">
              <h2 class="text-sm font-extrabold text-slate-900 bg-slate-100 p-3 rounded-xl border flex items-center gap-2">
                <span>👤</span> 1. Data Calon Murid
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="sm:col-span-2">
                  <label class="block font-bold text-slate-700 mb-1">Nama Lengkap Siswa</label>
                  <input type="text" name="nama_siswa" value={data.nama_siswa} required class="w-full p-3 bg-white rounded-xl border font-bold text-slate-900">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">NIK Siswa (16 Digit)</label>
                  <input type="text" name="nik_siswa" value={data.nik_siswa ?? ''} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">NISN</label>
                  <input type="text" name="nisn" value={data.nisn || ''} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div class="sm:col-span-2">
                  <label class="block font-bold text-slate-700 mb-1">Asal TK / RA / PAUD</label>
                  <input type="text" name="asal_sekolah" value={data.asal_sekolah || ''} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Tempat Lahir</label>
                  <input type="text" name="tempat_lahir" value={data.tempat_lahir ?? ''} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Tanggal Lahir</label>
                  <input type="date" name="tanggal_lahir" value={data.tanggal_lahir ?? ''} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Anak Ke- / Jumlah Saudara</label>
                  <div class="grid grid-cols-2 gap-2">
                    <input type="number" name="anak_ke" value={data.anak_ke ?? ''} placeholder="Anak ke" class="p-3 bg-white rounded-xl border">
                    <input type="number" name="jumlah_saudara" value={data.jumlah_saudara ?? ''} placeholder="Jml saudara" class="p-3 bg-white rounded-xl border">
                  </div>
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">No. Kartu Keluarga (KK)</label>
                  <input type="text" name="no_kk" value={data.no_kk ?? ''} class="w-full p-3 bg-white rounded-xl border font-semibold">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Tinggi Badan (cm)</label>
                  <input type="number" name="tinggi_badan" value={data.tinggi_badan || 0} class="w-full p-3 bg-white rounded-xl border">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Berat Badan (kg)</label>
                  <input type="number" name="berat_badan" value={data.berat_badan || 0} class="w-full p-3 bg-white rounded-xl border">
                </div>
              </div>

              <div class="pt-2 space-y-2 text-xs">
                <label class="block font-bold text-slate-800">Alamat Tempat Tinggal Siswa</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <input type="text" name="alamat_rt" value={data.alamat_rt || ''} placeholder="RT" class="p-3 bg-white rounded-xl border">
                  <input type="text" name="alamat_rw" value={data.alamat_rw || ''} placeholder="RW" class="p-3 bg-white rounded-xl border">
                  <input type="text" name="alamat_desa" value={data.alamat_desa ?? ''} placeholder="Desa" class="p-3 bg-white rounded-xl border font-bold">
                  <input type="text" name="alamat_kecamatan" value={data.alamat_kecamatan ?? ''} placeholder="Kecamatan" class="p-3 bg-white rounded-xl border font-bold">
                </div>
              </div>
            </div>

            <!-- BAGIAN 2: DATA ORANG TUA -->
            <div class="space-y-4 pt-4 border-t">
              <h2 class="text-sm font-extrabold text-slate-900 bg-slate-100 p-3 rounded-xl border flex items-center gap-2">
                <span>👨‍👩‍👧</span> 2. Data Orang Tua / Wali
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Nama Ayah Kandung</label>
                  <input type="text" name="nama_ayah" value={data.nama_ayah ?? ''} class="w-full p-3 bg-white rounded-xl border font-bold">
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">NIK Ayah / No. HP (WhatsApp)</label>
                  <div class="grid grid-cols-2 gap-2">
                    <input type="text" name="nik_ayah" value={data.nik_ayah ?? ''} placeholder="NIK Ayah" class="p-3 bg-white rounded-xl border">
                    <input type="text" name="hp_ayah" value={data.hp_ayah ?? ''} placeholder="No HP" class="p-3 bg-white rounded-xl border">
                  </div>
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Pekerjaan & Penghasilan Ayah</label>
                  <div class="grid grid-cols-2 gap-2">
                    <input type="text" name="pekerjaan_ayah" value={data.pekerjaan_ayah || ''} placeholder="Pekerjaan" class="p-3 bg-white rounded-xl border">
                    <input type="text" name="penghasilan_ayah" value={data.penghasilan_ayah || ''} placeholder="Penghasilan" class="p-3 bg-white rounded-xl border">
