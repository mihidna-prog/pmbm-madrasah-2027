                <td class="label">Nama Ibu Kandung</td>
                <td class="sep">:</td>
                <td><strong>{data.nama_ibu || '-'}</strong></td>
              </tr>
              <tr>
                <td class="label">NIK Ibu / No. HP</td>
                <td class="sep">:</td>
                <td>{data.nik_ibu || '-'} / {data.hp_ibu || '-'}</td>
              </tr>
              <tr>
                <td class="label">Pekerjaan / Penghasilan Ibu</td>
                <td class="sep">:</td>
                <td>{data.pekerjaan_ibu || '-'} / {data.penghasilan_ibu || '-'}</td>
              </tr>
            </table>

            <!-- C. BANTUAN & SERAGAM & KEUANGAN -->
            <div class="section-title font-extrabold bg-slate-200 border border-slate-400 px-2 py-1 mt-3">C. BANTUAN SOSIAL, SERAGAM & KEUANGAN</div>
            <table class="form-table w-full text-[11px]">
              <tr>
                <td class="label">Program Bantuan Sosial</td>
                <td class="sep">:</td>
                <td>{data.bantuan_sosial || 'Tidak Ada'}</td>
              </tr>
              <tr>
                <td class="label">Ukuran Seragam</td>
                <td class="sep">:</td>
                <td>Atasan: {data.ukuran_atasan || '-'}, Bawahan: {data.ukuran_bawahan || '-'}</td>
              </tr>
              <tr>
                <td class="label">Biaya Pendaftaran</td>
                <td class="sep">:</td>
                <td>Rp {(data.biaya_pendaftaran || 0).toLocaleString('id-ID')}</td>
              </tr>
              <tr>
                <td class="label">Titipan Uang Seragam</td>
                <td class="sep">:</td>
                <td>Rp {(data.biaya_seragam || 0).toLocaleString('id-ID')}</td>
              </tr>
            </table>

            <!-- D. STATUS BERKAS -->
            <div class="section-title font-extrabold bg-slate-200 border border-slate-400 px-2 py-1 mt-3">D. STATUS KELENGKAPAN BERKAS</div>
            <div class="status-berkas-print border border-slate-400 p-2">
              <table class="w-full text-center text-[10px]">
                <tr>
                  <td class="border border-slate-400 p-1">
                    <div class="font-bold">Pasfoto</div>
                    <div class={data.foto_siswa ? 'text-emerald-700 font-black' : 'text-rose-600 font-black'}>
                      {data.foto_siswa ? 'SUDAH' : 'BELUM'}
                    </div>
                  </td>
                  <td class="border border-slate-400 p-1">
                    <div class="font-bold">Akta Kelahiran</div>
                    <div class={data.foto_akta ? 'text-emerald-700 font-black' : 'text-rose-600 font-black'}>
                      {data.foto_akta ? 'SUDAH' : 'BELUM'}
                    </div>
                  </td>
                  <td class="border border-slate-400 p-1">
                    <div class="font-bold">Kartu Keluarga</div>
                    <div class={data.foto_kk ? 'text-emerald-700 font-black' : 'text-rose-600 font-black'}>
                      {data.foto_kk ? 'SUDAH' : 'BELUM'}
                    </div>
                  </td>
                  <td class="border border-slate-400 p-1">
                    <div class="font-bold">Foto Rumah</div>
                    <div class={data.foto_rumah ? 'text-emerald-700 font-black' : 'text-rose-600 font-black'}>
                      {data.foto_rumah ? 'SUDAH' : 'BELUM'}
                    </div>
                  </td>
                </tr>
              </table>
            </div>

            <!-- CATATAN PANITIA -->
            <div class="catatan-print border border-dashed border-slate-500 p-2 mt-3 text-[10px] leading-relaxed">
              <strong>Catatan Panitia:</strong>
              <ol class="list-decimal ml-4 mt-1">
                <li>Lembar ini diarsipkan oleh panitia PMBM.</li>
                <li>Verifikasi berkas fisik dilakukan sesuai jadwal yang ditentukan.</li>
                <li>Data dapat diperbarui apabila terdapat kekeliruan.</li>
              </ol>
            </div>

            <!-- TANDA TANGAN PANITIA -->
            <div class="ttd flex justify-between mt-5 px-2 text-center text-[11px]">
              <div class="w-[45%]">
                <p>Mengetahui,<br/>Kepala Madrasah</p>
                <div class="ruang-ttd h-14"></div>
                <p class="font-bold underline">( ................................ )</p>
              </div>
              <div class="w-[45%]">
                <p>Krasak, {tanggalCetak}<br/>Petugas Panitia PMBM</p>
                <div class="ruang-ttd h-14"></div>
                <p class="font-bold underline">( ................................ )</p>
              </div>
            </div>
          </div>

          <!-- TOMBOL AKSI MODAL (TIDAK IKUT CETAK) -->
          <div class="flex items-center justify-center gap-3 pt-4 pb-6 no-print">
            <button onclick="window.print()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs px-6 py-3 rounded-xl shadow-md transition">
              🖨️ Cetak Dokumen 2 Halaman (A4 Full)
            </button>
            <button id="btnCloseResi" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs px-6 py-3 rounded-xl transition">
              Tutup
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- SCRIPT -->
    <script>
      // ===== Auth Guard =====
      if (!sessionStorage.getItem('isAdminLoggedIn')) {
        window.location.href = '/admin/login';
      }

      // ===== File Upload Base64 Helper =====
      function setupFileUpload(fileInputId: string, hiddenInputId: string, previewImgId: string, placeholderId: string) {
        const fileInput = document.getElementById(fileInputId) as HTMLInputElement | null;
        const hiddenInput = document.getElementById(hiddenInputId) as HTMLInputElement | null;
        const previewImg = document.getElementById(previewImgId) as HTMLImageElement | null;
        const placeholder = document.getElementById(placeholderId);

        if (!fileInput) return;

        fileInput.addEventListener('change', (e: Event) => {
          const target = e.target as HTMLInputElement;
          const file = target.files?.[0];
          if (!file) return;

          const reader = new FileReader();
          reader.onload = (uploadEvent) => {
            const base64String = uploadEvent.target?.result as string;
            if (hiddenInput) hiddenInput.value = base64String;
            if (previewImg) {
              previewImg.src = base64String;
              previewImg.classList.remove('hidden');
            }
            if (placeholder) placeholder.classList.add('hidden');
          };
          reader.readAsDataURL(file);
        });
      }

      setupFileUpload('file_pasfoto', 'hidden_pasfoto', 'img_preview_pasfoto', 'text_placeholder_pasfoto');
      setupFileUpload('file_akta', 'hidden_akta', 'img_preview_akta', 'text_placeholder_akta');
      setupFileUpload('file_kk', 'hidden_kk', 'img_preview_kk', 'text_placeholder_kk');
      setupFileUpload('file_rumah', 'hidden_rumah', 'img_preview_rumah', 'text_placeholder_rumah');
      setupFileUpload('file_pkh', 'hidden_pkh', 'img_preview_pkh', 'text_placeholder_pkh');
      setupFileUpload('file_pip', 'hidden_pip', 'img_preview_pip', 'text_placeholder_pip');
      setupFileUpload('file_kip', 'hidden_kip', 'img_preview_kip', 'text_placeholder_kip');
      setupFileUpload('file_bpnt', 'hidden_bpnt', 'img_preview_bpnt', 'text_placeholder_bpnt');

      // ===== Dropdown Bantuan Sosial Dinamis =====
      const selectBantuan = document.getElementById('selectBantuanSosial') as HTMLSelectElement | null;

      function updateBantuanCardVisibility() {
        if (!selectBantuan) return;
        const val = selectBantuan.value;
        document.querySelectorAll('.bantuan-card').forEach((card) => {
          (card as HTMLElement).style.display = 'none';
        });

        if (val.includes('PKH')) {
          const el = document.getElementById('card_pkh');
          if (el) el.style.display = 'block';
        } else if (val.includes('PIP')) {
          const el = document.getElementById('card_pip');
          if (el) el.style.display = 'block';
        } else if (val.includes('KIP')) {
          const el = document.getElementById('card_kip');
          if (el) el.style.display = 'block';
        } else if (val.includes('BPNT')) {
          const el = document.getElementById('card_bpnt');
          if (el) el.style.display = 'block';
        }
      }

      selectBantuan?.addEventListener('change', updateBantuanCardVisibility);
      updateBantuanCardVisibility();

      // ===== Submit Form =====
      const formAdminDetail = document.getElementById('formAdminDetail') as HTMLFormElement | null;
      if (formAdminDetail) {
        formAdminDetail.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('btnSaveDetail') as HTMLButtonElement;
          btn.disabled = true;
          btn.innerText = 'Menyimpan Koreksi Data & Berkas...';

          const formData = new FormData(formAdminDetail);
          const dataObj: Record<string, unknown> = Object.fromEntries(formData.entries());

          const getVal = (id: string) =>
            (document.getElementById(id) as HTMLInputElement | null)?.value || '';

          dataObj.foto_siswa = getVal('hidden_pasfoto');
          dataObj.foto_akta = getVal('hidden_akta');
          dataObj.foto_kk = getVal('hidden_kk');
          dataObj.foto_rumah = getVal('hidden_rumah');
          dataObj.foto_pkh = getVal('hidden_pkh');
          dataObj.foto_pip = getVal('hidden_pip');
          dataObj.foto_kip = getVal('hidden_kip');
          dataObj.foto_bpnt = getVal('hidden_bpnt');

          dataObj.action = 'update_full_pendaftar';

          try {
            const res = await fetch('/api/admin-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(dataObj),
            });
            const result = await res.json();
            if (result.success) {
              alert('✅ Koreksi data formulir & berkas berhasil disimpan!');
              location.reload();
            } else {
              alert('❌ Gagal Menyimpan: ' + (result.message || 'Kesalahan server'));
            }
          } catch (err) {
            alert('❌ Terjadi kesalahan koneksi server.');
          } finally {
            btn.disabled = false;
            btn.innerText = '💾 Simpan Koreksi Data Formulir';
          }
        });
      }

      // ===== Modal Cetak =====
      const modalCetakResi = document.getElementById('modalCetakResi');
      const btnOpenCetak = document.getElementById('btnOpenCetak');
      const btnCetakBawah = document.getElementById('btnCetakBawah');
      const btnCloseResi = document.getElementById('btnCloseResi');

      btnOpenCetak?.addEventListener('click', () => modalCetakResi?.classList.remove('hidden'));
      btnCetakBawah?.addEventListener('click', () => modalCetakResi?.classList.remove('hidden'));
      btnCloseResi?.addEventListener('click', () => modalCetakResi?.classList.add('hidden'));
    </script>
  </body>
</html>