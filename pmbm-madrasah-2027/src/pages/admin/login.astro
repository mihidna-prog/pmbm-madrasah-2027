---
import '../../styles/global.css';

const namaSekolah = "MI Hidayatul Husna Krasak";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Login Panitia PMBM - {namaSekolah}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
  </head>
  <body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col justify-between items-center p-4">

    <!-- Navigasi Ringkas -->
    <div class="w-full max-w-md flex justify-between items-center pt-4">
      <a href="/" class="text-xs font-bold text-emerald-800 hover:text-emerald-900 bg-emerald-100/80 px-3.5 py-2 rounded-xl border border-emerald-200 transition">
        ← Kembali ke Web Utama
      </a>
      <span class="text-[11px] font-bold text-slate-400">Portal Panitia</span>
    </div>

    <!-- Form Login Admin Card -->
    <main class="w-full max-w-md my-auto py-6">
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xl space-y-6">
        
        <!-- Header Logo -->
        <div class="text-center space-y-3">
          <img 
            src="/logo.png" 
            alt="Logo MI Hidayatul Husna" 
            class="w-20 h-20 object-contain mx-auto drop-shadow"
            onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-16 h-16 bg-emerald-700 text-white font-black text-xl flex items-center justify-center rounded-2xl mx-auto\'>MI</div>';"
          />
          <div>
            <h1 class="text-xl font-black text-slate-900">Login Panitia PMBM</h1>
            <p class="text-xs text-slate-500 mt-1">{namaSekolah}</p>
          </div>
        </div>

        <!-- Alert Notifikasi Error -->
        <div id="loginAlert" class="hidden p-3.5 rounded-2xl text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200 text-center"></div>

        <!-- Form Input -->
        <form id="formLoginAdmin" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Username Admin</label>
            <input 
              type="text" 
              id="inputUsername" 
              required 
              placeholder="Masukkan username admin"
              class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Password</label>
            <input 
              type="password" 
              id="inputPassword" 
              required 
              placeholder="••••••••"
              class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium"
            />
          </div>

          <button 
            type="submit" 
            id="btnLogin" 
            class="w-full bg-emerald-700 hover:bg-emerald-800 active:scale-95 text-white font-extrabold text-xs py-4 rounded-xl shadow-lg shadow-emerald-700/20 transition"
          >
            Masuk ke Dashboard Admin →
          </button>
        </form>

        <div class="text-center border-t border-slate-100 pt-4">
          <p class="text-[11px] text-slate-400">Default: Username: <strong>admin</strong> | Password: <strong>admin123</strong></p>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="text-center text-[11px] text-slate-400 pb-4">
      © 2026 {namaSekolah}. Sistem Manajemen PMBM.
    </footer>

    <!-- Script Autentikasi Login Client-Side -->
    <script>
      const formLoginAdmin = document.getElementById('formLoginAdmin') as HTMLFormElement | null;
      const loginAlert = document.getElementById('loginAlert') as HTMLElement | null;
      const btnLogin = document.getElementById('btnLogin') as HTMLButtonElement | null;

      if (formLoginAdmin && loginAlert && btnLogin) {
        formLoginAdmin.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const usernameInput = document.getElementById('inputUsername') as HTMLInputElement;
          const passwordInput = document.getElementById('inputPassword') as HTMLInputElement;

          const username = usernameInput ? usernameInput.value : '';
          const password = passwordInput ? passwordInput.value : '';

          btnLogin.disabled = true;
          btnLogin.innerText = 'Memeriksa Akses...';

          // Simulasi Kredensial Admin Panitia
          setTimeout(() => {
            if (username === 'admin' && password === 'admin123') {
              sessionStorage.setItem('isAdminLoggedIn', 'true');
              window.location.href = '/admin';
            } else {
              loginAlert.innerText = '❌ Username atau Password salah!';
              loginAlert.classList.remove('hidden');
              btnLogin.disabled = false;
              btnLogin.innerText = 'Masuk ke Dashboard Admin →';
            }
          }, 600);
        });
      }
    </script>
  </body>
</html>