---
import '../styles/global.css';

const namaSekolah = "MI Hidayatul Husna Krasak";
const alamatSekolah = "Krasak, Pecangaan, Jepara";
const tahunAjaran = "2027/2028";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Formulir Pendaftaran PMBM - {namaSekolah}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> 
      body { font-family: 'Plus Jakarta Sans', sans-serif; } 
      @media print {
        body * { visibility: hidden; }
        #modalBukti, #modalBukti * { visibility: visible; }
        #modalBukti { position: absolute; left: 0; top: 0; width: 100%; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body class="bg-slate-100 text-slate-800 antialiased min-h-screen pb-16">

    <!-- Header Navbar -->
    <nav class="bg-emerald-900 text-white p-4 sticky top-0 z-30 shadow-md">
      <div class="max-w-3xl mx-auto flex items-center justify-between">
        <a href="/" class="text-xs font-bold bg-emerald-800 hover:bg-emerald-700 px-3.5 py-2 rounded-xl border border-emerald-700 transition">
          ← Kembali ke Beranda
        </a>
        <div class="flex items-center gap-2">
          <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain" onerror="this.remove()"/>
          <span class="font-extrabold text-xs sm:text-sm tracking-tight">{namaSekolah}</span>
        </div>
      </div>
    </nav>

    <!-- Main Form Container -->
    <main class="max-w-3xl mx-auto px-4 py-6">
      <div class="bg-white p-6 sm:p-10 rounded-3xl border border-slate-200/80 shadow-xl space-y-8">
        
        <!-- Header Judul -->
        <div class="border-b border-slate-100 pb-4 text-center sm:text-left">
          <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 uppercase tracking-wider">
            Formulir PMBM Online TA {tahunAjaran}
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">Pendaftaran Murid Baru</h1>
          <p class="text-xs text-slate-500 mt-1">Lengkapi data calon murid dan orang tua sesuai Kartu Keluarga (KK).</p>
        </div>

        <form id="formLengkapPMB" class="space-y-8">
          
          <!-- BAGIAN 1: DATA SISWA -->
          <div class="space-y-4">
            <h2 class="text-sm font-extrabold text-emerald-900 bg-emerald-50 p-3 rounded-xl border border-emerald-100 flex items-center gap-2">
              <span>👤</span> 1. Data Calon Murid
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Siswa *</label>
                <input type="text" id="nama_siswa" name="nama_siswa" required placeholder="Sesuai Akta Kelahiran" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">NIK Siswa (16 Digit) *</label>
                <input type="number" name="nik_siswa" required placeholder="Lihat di Kartu Keluarga" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">NISN (Jika Ada)</label>
                <input type="number" name="nisn" placeholder="Kosongkan jika belum ada" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-slate-700 mb-1">Asal TK / RA / Paud</label>
                <input type="text" name="asal_sekolah" placeholder="Contoh: TK RA Hidayatul Husna" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tempat Lahir *</label>
                <input type="text" name="tempat_lahir" required placeholder="Kota kelahiran" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Lahir *</label>
                <input type="date" name="tanggal_lahir" required class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Anak Ke- *</label>
                <input type="number" name="anak_ke" required value="1" min="1" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Jumlah Saudara *</label>
                <input type="number" name="jumlah_saudara" required value="1" min="1" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Agama *</label>
                <select name="agama" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
                  <option value="Islam">Islam</option>
                  <option value="Lainnya">Lainnya</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">No. Kartu Keluarga (KK) *</label>
                <input type="number" name="no_kk" required placeholder="16 Digit No. KK" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tinggi Badan (cm)</label>
                <input type="number" name="tinggi_badan" placeholder="Contoh: 115" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Berat Badan (kg)</label>
                <input type="number" name="berat_badan" placeholder="Contoh: 20" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              </div>
            </div>

            <!-- Detail Alamat Rumah Siswa -->
            <div class="pt-2 space-y-3">
              <label class="block text-xs font-bold text-slate-800 border-b pb-1">Detail Alamat Tempat Tinggal Siswa</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">RT</label>
                  <input type="text" id="alamat_rt" name="alamat_rt" placeholder="01" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">RW</label>
                  <input type="text" id="alamat_rw" name="alamat_rw" placeholder="02" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">Desa / Kelurahan *</label>
                  <input type="text" id="alamat_desa" name="alamat_desa" required placeholder="Krasak" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">Kecamatan *</label>
                  <input type="text" id="alamat_kecamatan" name="alamat_kecamatan" required placeholder="Pecangaan" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
              </div>
            </div>

          </div>

          <!-- BAGIAN 2: DATA ORANG TUA -->
          <div class="space-y-4 pt-4 border-t border-slate-100">
            <h2 class="text-sm font-extrabold text-emerald-900 bg-emerald-50 p-3 rounded-xl border border-emerald-100 flex items-center gap-2">
              <span>👨‍👩‍👧</span> 2. Data Orang Tua / Wali
            </h2>

            <!-- Data Ayah -->
            <div class="space-y-3">
              <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">A. Data Ayah Kandung</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Ayah *</label>
                  <input type="text" name="nama_ayah" required placeholder="Nama Ayah" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">NIK Ayah (16 Digit) *</label>
                  <input type="number" name="nik_ayah" required placeholder="NIK Ayah" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Pekerjaan Ayah</label>
                  <input type="text" name="pekerjaan_ayah" placeholder="Misal: Wiraswasta / Buruh" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">No. HP / WhatsApp Ayah *</label>
                  <input type="tel" name="hp_ayah" required placeholder="081234567890" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-bold text-slate-700 mb-1">Penghasilan Ayah per Bulan</label>
                  <select name="penghasilan_ayah" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                    <option value="< 1 Juta">Kurang dari Rp 1.000.000</option>
                    <option value="1 - 3 Juta">Rp 1.000.000 - Rp 3.000.000</option>
                    <option value="3 - 5 Juta">Rp 3.000.000 - Rp 5.000.000</option>
                    <option value="> 5 Juta">Lebih dari Rp 5.000.000</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Data Ibu -->
            <div class="space-y-3 pt-2">
              <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">B. Data Ibu Kandung</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Ibu *</label>
                  <input type="text" name="nama_ibu" required placeholder="Nama Ibu" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">NIK Ibu (16 Digit) *</label>
                  <input type="number" name="nik_ibu" required placeholder="NIK Ibu" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Pekerjaan Ibu</label>
                  <input type="text" name="pekerjaan_ibu" placeholder="Misal: Ibu Rumah Tangga / Guru" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">No. HP Ibu (Opsional)</label>
                  <input type="tel" name="hp_ibu" placeholder="081234567890" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-bold text-slate-700 mb-1">Penghasilan Ibu per Bulan</label>
                  <select name="penghasilan_ibu" class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-medium">
                    <option value="Tidak Berpenghasilan">Tidak Berpenghasilan</option>
                    <option value="< 1 Juta">Kurang dari Rp 1.000.000</option>
                    <option value="1 - 3 Juta">Rp 1.000.000 - Rp 3.000.000</option>
                    <option value="> 3 Juta">Lebih dari Rp 3.000.000</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Detail Alamat Tempat Tinggal Orang Tua -->
            <div class="pt-3 space-y-3">
              <div class="flex items-center justify-between border-b pb-1">
                <label class="block text-xs font-bold text-slate-800">Detail Alamat Orang Tua</label>
                <label class="flex items-center gap-1.5 text-xs font-bold text-emerald-700 cursor-pointer">
                  <input type="checkbox" id="chkSamaAlamat" class="w-3.5 h-3.5 text-emerald-600 rounded">
                  <span>Sama dengan alamat siswa</span>
                </label>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">RT Ortu</label>
                  <input type="text" id="ortu_rt" name="ortu_rt" placeholder="01" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">RW Ortu</label>
                  <input type="text" id="ortu_rw" name="ortu_rw" placeholder="02" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">Desa Ortu</label>
                  <input type="text" id="ortu_desa" name="ortu_desa" placeholder="Krasak" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">Kecamatan Ortu</label>
                  <input type="text" id="ortu_kecamatan" name="ortu_kecamatan" placeholder="Pecangaan" class="w-full text-xs p-3 bg-slate-50 rounded-xl border border-slate-200">
                </div>
              </div>
            </div>

          </div>

          <!-- BAGIAN 3: BANTUAN SOSIAL & UPLOAD DOKUMEN KONDISIONAL -->
          <div class="space-y-4 pt-4 border-t border-slate-100">
            <h2 class="text-sm font-extrabold text-emerald-900 bg-emerald-50 p-3 rounded-xl border border-emerald-100 flex items-center gap-2">
              <span>💳</span> 3. Program Bantuan Sosial (Centang Jika Memiliki)
            </h2>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-50 p-4 rounded-2xl border border-slate-200">
              <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input type="checkbox" name="bantuan_sosial" value="PKH" class="chk-bantuan w-4 h-4 text-emerald-600 rounded">
                <span>PKH</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input type="checkbox" name="bantuan_sosial" value="KKS" class="chk-bantuan w-4 h-4 text-emerald-600 rounded">
                <span>KKS</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input type="checkbox" name="bantuan_sosial" value="KIP" class="chk-bantuan w-4 h-4 text-emerald-600 rounded">
                <span>KIP</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input type="checkbox" name="bantuan_sosial" value="Lainnya" class="chk-bantuan w-4 h-4 text-emerald-600 rounded">
                <span>Lainnya</span>
              </label>
            </div>

            <!-- Tombol Foto/Upload Bantuan (Kondisional) -->
            <div id="boxUploadBantuan" class="hidden p-4 bg-amber-50 border border-amber-200 rounded-2xl space-y-2">
              <label class="block text-xs font-bold text-amber-900">📷 Upload / Foto Kartu Bantuan Sosial (PKH/KKS/KIP)</label>
              <input type="file" accept="image/*" capture="environment" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-amber-200 file:text-amber-900 hover:file:bg-amber-300">
            </div>
          </div>

          <!-- BAGIAN 4: UPLOAD DOKUMEN UTAMA -->
          <div class="space-y-4 pt-4 border-t border-slate-100">
            <h2 class="text-sm font-extrabold text-emerald-900 bg-emerald-50 p-3 rounded-xl border border-emerald-100 flex items-center gap-2">
              <span>📷</span> 4. Upload / Foto Dokumen Utama
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
                <label class="block text-xs font-bold text-slate-800">1. Pasfoto Siswa (Berwarna)</label>
                <input type="file" accept="image/*" capture="environment" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
              </div>

              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
                <label class="block text-xs font-bold text-slate-800">2. Foto / Scan Akta Kelahiran</label>
                <input type="file" accept="image/*" capture="environment" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
              </div>

              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
                <label class="block text-xs font-bold text-slate-800">3. Foto / Scan Kartu Keluarga (KK)</label>
                <input type="file" accept="image/*" capture="environment" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
              </div>

              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
                <label class="block text-xs font-bold text-slate-800">4. Foto Depan Rumah</label>
                <input type="file" accept="image/*" capture="environment" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
              </div>
            </div>
          </div>

          <!-- BAGIAN 5: TABEL & PEMISAHAN DROPDOWN UKURAN SERAGAM -->
          <div class="space-y-4 pt-4 border-t border-slate-100">
            <h2 class="text-sm font-extrabold text-emerald-900 bg-emerald-50 p-3 rounded-xl border border-emerald-100 flex items-center gap-2">
              <span>👕</span> 5. Ukuran Seragam Sekolah (Atasan & Bawahan)
            </h2>

            <!-- Tabel Panduan Ukuran Detail -->
            <div class="overflow-x-auto rounded-2xl border border-slate-200">
              <table class="w-full text-xs text-left text-slate-600">
                <thead class="bg-slate-100 font-bold text-slate-800 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Ukuran</th>
                    <th class="p-2.5">Panjang Atasan</th>
                    <th class="p-2.5">Lingkar Dada</th>
                    <th class="p-2.5">Panjang Bawahan</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <tr>
                    <td class="p-2.5 font-bold text-emerald-700">S</td>
                    <td class="p-2.5">48 cm</td>
                    <td class="p-2.5">72 cm</td>
                    <td class="p-2.5">65 cm</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-bold text-emerald-700">M</td>
                    <td class="p-2.5">52 cm</td>
                    <td class="p-2.5">76 cm</td>
                    <td class="p-2.5">70 cm</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-bold text-emerald-700">L</td>
                    <td class="p-2.5">56 cm</td>
                    <td class="p-2.5">80 cm</td>
                    <td class="p-2.5">75 cm</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-bold text-emerald-700">XL</td>
                    <td class="p-2.5">60 cm</td>
                    <td class="p-2.5">84 cm</td>
                    <td class="p-2.5">80 cm</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Pemisahan Dropdown Ukuran Atasan & Bawahan -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-800 mb-1">Pilih Ukuran Atasan (Baju) *</label>
                <select name="ukuran_atasan" required class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-bold text-emerald-800">
                  <option value="S">Atasan Ukuran S</option>
                  <option value="M" selected>Atasan Ukuran M (Standard Class 1)</option>
                  <option value="L">Atasan Ukuran L</option>
                  <option value="XL">Atasan Ukuran XL</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-800 mb-1">Pilih Ukuran Bawahan (Celana/Rok) *</label>
                <select name="ukuran_bawahan" required class="w-full text-xs p-3.5 bg-slate-50 rounded-xl border border-slate-200 font-bold text-emerald-800">
                  <option value="S">Bawahan Ukuran S</option>
                  <option value="M" selected>Bawahan Ukuran M (Standard Class 1)</option>
                  <option value="L">Bawahan Ukuran L</option>
                  <option value="XL">Bawahan Ukuran XL</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Tombol Submit -->
          <div class="pt-6">
            <button 
              type="submit" 
              id="btnSubmit" 
              class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-sm py-4 rounded-2xl shadow-xl shadow-emerald-600/30 transition"
            >
              Simpan & Dapatkan Bukti Pendaftaran →
            </button>
          </div>

        </form>
      </div>
    </main>

    <!-- MODAL CETAK BUKTI PENDAFTARAN DIGITAL -->
    <div id="modalBukti" class="hidden fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
      <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl space-y-6 border border-slate-200">
        
        <div class="text-center border-b border-slate-200 pb-4 space-y-2">
          <img src="/logo.png" alt="Logo MI" class="w-16 h-16 object-contain mx-auto" onerror="this.remove()"/>
          <h3 class="font-black text-lg text-slate-900 leading-tight">{namaSekolah}</h3>
          <p class="text-[11px] text-slate-500">{alamatSekolah}</p>
          <span class="inline-block bg-emerald-100 text-emerald-800 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
            BUKTI PENDAFTARAN PMBM TA {tahunAjaran}
          </span>
        </div>

        <div class="space-y-3 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <div class="flex justify-between border-b pb-2">
            <span class="text-slate-500">No. Pendaftaran:</span>
            <span id="resNoPendaftaran" class="font-black text-emerald-700">PMBM-2027-000</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-slate-500">Nama Siswa:</span>
            <span id="resNamaSiswa" class="font-bold text-slate-900">-</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-slate-500">Tanggal Daftar:</span>
            <span id="resTglDaftar" class="font-medium text-slate-700">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Status Berkas:</span>
            <span class="font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded text-[10px]">Menunggu Validasi Fisik</span>
          </div>
        </div>

        <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl text-[11px] text-amber-900 space-y-1">
          <p class="font-bold">⚠️ Petunjuk Cetak & Validasi:</p>
          <p>Silahkan cetak lembar ini dan bawa bersama <strong>Fotokopi KK & Akta Asli</strong> ke sekretariat madrasah saat tes observasi.</p>
        </div>

        <div class="flex gap-3 no-print">
          <button 
            onclick="window.print()" 
            class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-3.5 rounded-xl shadow-md transition"
          >
            🖨️ Cetak Bukti Pendaftaran
          </button>
          <a 
            href="/" 
            class="w-full text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs py-3.5 rounded-xl transition"
          >
            Selesai
          </a>
        </div>

      </div>
    </div>

    <!-- SCRIPT CLIENT SIDE INTERAKTIF -->
    <script>
      // 1. Checkbox Alamat Ortu Sama Dengan Siswa
      const chkSamaAlamat = document.getElementById('chkSamaAlamat') as HTMLInputElement | null;
      if (chkSamaAlamat) {
        chkSamaAlamat.addEventListener('change', () => {
          if (chkSamaAlamat.checked) {
            (document.getElementById('ortu_rt') as HTMLInputElement).value = (document.getElementById('alamat_rt') as HTMLInputElement).value;
            (document.getElementById('ortu_rw') as HTMLInputElement).value = (document.getElementById('alamat_rw') as HTMLInputElement).value;
            (document.getElementById('ortu_desa') as HTMLInputElement).value = (document.getElementById('alamat_desa') as HTMLInputElement).value;
            (document.getElementById('ortu_kecamatan') as HTMLInputElement).value = (document.getElementById('alamat_kecamatan') as HTMLInputElement).value;
          }
        });
      }

      // 2. Handling Kondisional Upload Bantuan Sosial
      const chkBantuan = document.querySelectorAll('.chk-bantuan');
      const boxUploadBantuan = document.getElementById('boxUploadBantuan');

      chkBantuan.forEach(chk => {
        chk.addEventListener('change', () => {
          const isAnyChecked = Array.from(chkBantuan).some((c: any) => c.checked);
          if (isAnyChecked) {
            boxUploadBantuan?.classList.remove('hidden');
          } else {
            boxUploadBantuan?.classList.add('hidden');
          }
        });
      });

      // 3. Handling Submit Form & Modal Resi
      const form = document.getElementById('formLengkapPMB') as HTMLFormElement | null;
      const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement | null;
      const modalBukti = document.getElementById('modalBukti') as HTMLElement | null;

      if (form && btnSubmit && modalBukti) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          btnSubmit.disabled = true;
          btnSubmit.innerText = 'Menyimpan Data Pendaftaran...';

          const formData = new FormData(form);
          const bantuanArr = formData.getAll('bantuan_sosial');
          const dataObj = Object.fromEntries(formData.entries());
          dataObj.bantuan_sosial = bantuanArr as any;

          try {
            const res = await fetch('/api/daftar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(dataObj)
            });

            const result = await res.json();

            if (result.success) {
              (document.getElementById('resNoPendaftaran') as HTMLElement).innerText = result.noPendaftaran;
              (document.getElementById('resNamaSiswa') as HTMLElement).innerText = result.namaSiswa;
              (document.getElementById('resTglDaftar') as HTMLElement).innerText = result.tglDaftar;

              modalBukti.classList.remove('hidden');
              form.reset();
            } else {
              throw new Error(result.message);
            }
          } catch (err: any) {
            alert('❌ Gagal Menyimpan: ' + (err.message || 'Koneksi database terputus'));
          } finally {
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Simpan & Dapatkan Bukti Pendaftaran →';
          }
        });
      }
    </script>
  </body>
</html>